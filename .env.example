# ─────────────────────────────────────────────────────────────────────
# Resume Builder — cloud sync (Firebase). OPTIONAL.
# Without these, the app still works but saves on this device only.
#
# Get these values from: Firebase Console → Project settings → General →
# "Your apps" → SDK setup and configuration → Config.
# Copy this file to `.env` and fill in the values.
#
# NOTE: to share the SAME data as the portfolio version, use the SAME
# Firebase project values here.
# ─────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single admin account (uploads the public resume + views everyone's).
VITE_OWNER_EMAIL=
